// Divine Journey 2 Modern - additions that did not exist in the original pack.
// The One Probe items are hidden from JEI in config/jei/itemBlacklist.cfg;
// this script removes their crafting recipes so they cannot be crafted either.
// To restore TOP, delete this file and the theoneprobe lines in itemBlacklist.cfg.

recipes.remove(<theoneprobe:probe>);
recipes.remove(<theoneprobe:probe_goggles>);
recipes.remove(<theoneprobe:iron_helmet_probe>);
recipes.remove(<theoneprobe:gold_helmet_probe>);
recipes.remove(<theoneprobe:diamond_helmet_probe>);
recipes.remove(<theoneprobe:creativeprobe>);
recipes.remove(<theoneprobe:probenote>);
